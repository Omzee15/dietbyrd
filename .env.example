# ── Database (required) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── App environment ──────────────────────────────────────────────────
# "dev" prints OTP codes to the console instead of sending real SMS/WhatsApp
APP_ENV=production
PORT=3001

# ── Auth / security secrets (required in production) ────────────────
# Signs registration/referral tokens. MUST be set to a long random value
# in production - the code falls back to a hardcoded default otherwise.
REGISTRATION_TOKEN_SECRET=
# Signs time-limited patient document download links. Falls back to
# REGISTRATION_TOKEN_SECRET if unset, but a distinct secret is safer.
DOCUMENT_URL_SECRET=

# ── Razorpay (payments) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
# Required for /api/payments/webhook to accept any requests at all
# (Razorpay dashboard -> Settings -> Webhooks -> Secret)
RAZORPAY_WEBHOOK_SECRET=

# ── Exotel (OTP / SMS / WhatsApp) ────────────────────────────────────
# Core account credentials (Exotel Dashboard -> Settings -> API Settings)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.exotel.com

# SMS (needs DLT entity + sender ID registered with a telecom operator)
EXOTEL_SMS_SENDER_ID=
EXOTEL_DLT_ENTITY_ID=
EXOTEL_SMS_DLT_TEMPLATE_ID=

# ExoVerify (OTP) -- a separate app-level credential pair, not the account API key/token
EXOTEL_EXOVERIFY_APP_ID=
EXOTEL_EXOVERIFY_APP_SECRET=

# WhatsApp Business (approved templates)
EXOTEL_WHATSAPP_FROM=
EXOTEL_WHATSAPP_TEMPLATE_WELCOME=
EXOTEL_WHATSAPP_TEMPLATE_REFERRAL=

# "log" (default) only records what would be sent; "live" actually sends
# referral notifications through Exotel
REFERRAL_SMS_MODE=

# ── SendGrid (email) ──────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=DietByRD

# ── Supabase (optional file storage for patient documents) ──────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta / WhatsApp webhook verification ─────────────────────────────
META_VERIFY_TOKEN=

# ── URLs used when building links in emails/SMS ──────────────────────
PUBLIC_SITE_URL=
FRONTEND_URL=

# ── Misc / operational toggles ────────────────────────────────────────
PGPOOL_MAX=1
PG_CONNECTION_TIMEOUT_MS=10000
ENABLE_AUTO_ASSIGN_SCHEDULER=false
RUN_STARTUP_MAINTENANCE=false
RUN_FOOD_LIBRARY_SEED_ON_STARTUP=false

# These are set automatically by Netlify/Vercel - do not set manually
# VITE_API_URL is not needed - the frontend API client uses relative paths
